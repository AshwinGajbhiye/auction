# Environment variables — copy to .env and fill in real values
# NEVER commit the real .env file

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=campusloop
POSTGRES_PASSWORD=campusloop_dev
POSTGRES_DB=campusloop
POSTGRES_PORT=5432
DATABASE_URL="postgresql://campusloop:campusloop_dev@localhost:5432/campusloop?schema=public"
TEST_DATABASE_URL="postgresql://campusloop_test:campusloop_test@localhost:5433/campusloop_test?schema=public"

# ─── API server ──────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000

# ─── Session ─────────────────────────────────────────────────────────────────
SESSION_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── Email (dev: logs to console; prod: set real SMTP) ───────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="CampusLoop <no-reply@campusloop.dev>"

# ─── Image storage ───────────────────────────────────────────────────────────
# STORAGE_DRIVER=local   (development)
# STORAGE_DRIVER=s3      (production)
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads
MAX_IMAGE_SIZE_MB=5
MAX_IMAGES_PER_LISTING=8

# S3 / R2 — only needed when STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ─── Auction worker ───────────────────────────────────────────────────────────
AUCTION_CLOSE_CRON="* * * * *"
AUCTION_SNIPE_EXTENSION_SECONDS=30
AUCTION_SNIPE_WINDOW_SECONDS=30
AUCTION_SNIPE_ENABLED=true

# ─── Security ────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
PASSWORD_RESET_EXPIRY_MINUTES=60
EMAIL_VERIFY_EXPIRY_HOURS=24

# ─── Rate limiting ────────────────────────────────────────────────────────────
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
