// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum UserRole {
  STUDENT
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum CollegeStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum ItemCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  FOR_PARTS
}

enum ListingType {
  FIXED_PRICE
  AUCTION
}

enum ListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  RESERVED
  SOLD
  DELETED
}

enum AuctionStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum PurchaseStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
  EXCHANGE_PENDING
  COMPLETED
  DISPUTED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTERED
  EXPIRED
  WITHDRAWN
}

enum ReportCategory {
  FRAUDULENT_LISTING
  PROHIBITED_ITEM
  MISLEADING_DESCRIPTION
  SUSPICIOUS_SELLER
  HARASSMENT
  SPAM
  PAYMENT_DISPUTE
  OTHER
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum NotificationType {
  NEW_MESSAGE
  PURCHASE_REQUEST
  PURCHASE_ACCEPTED
  PURCHASE_REJECTED
  OFFER_RECEIVED
  OFFER_ACCEPTED
  OFFER_REJECTED
  COUNTER_OFFER
  OUTBID
  AUCTION_ENDING_SOON
  AUCTION_WON
  AUCTION_LOST
  LISTING_EXPIRED
  EXCHANGE_CONFIRMED
  NEW_REVIEW
  MODERATION_ACTION
}

// ─── Models ─────────────────────────────────────────────────────────────────

model College {
  id                   String        @id @default(cuid())
  name                 String
  slug                 String        @unique
  approvedEmailDomains String[]
  status               CollegeStatus @default(PENDING)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  users    User[]
  listings Listing[]

  @@map("colleges")
}

model User {
  id              String     @id @default(cuid())
  name            String
  email           String     @unique
  passwordHash    String
  collegeId       String
  role            UserRole   @default(STUDENT)
  emailVerifiedAt DateTime?
  profileImageUrl String?
  course          String?
  graduationYear  Int?
  status          UserStatus @default(ACTIVE)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  college                College              @relation(fields: [collegeId], references: [id])
  listings               Listing[]            @relation("SellerListings")
  emailVerifications     EmailVerification[]
  passwordResets         PasswordReset[]
  purchasesAsBuyer       Purchase[]           @relation("BuyerPurchases")
  purchasesAsSeller      Purchase[]           @relation("SellerPurchases")
  offersAsBuyer          Offer[]              @relation("BuyerOffers")
  offersAsSeller         Offer[]              @relation("SellerOffers")
  bids                   Bid[]
  conversationsAsBuyer   Conversation[]       @relation("BuyerConversations")
  conversationsAsSeller  Conversation[]       @relation("SellerConversations")
  messagesSent           Message[]
  favourites             Favourite[]
  notifications          Notification[]
  reviewsGiven           Review[]             @relation("ReviewerReviews")
  reviewsReceived        Review[]             @relation("RevieweeReviews")
  reportsFiledBy         Report[]             @relation("ReporterReports")
  reportsAgainst         Report[]             @relation("ReportedUserReports")
  assignedReports        Report[]             @relation("ModeratorReports")
  auditLogs              AuditLog[]

  @@index([collegeId])
  @@index([email])
  @@map("users")
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("email_verifications")
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("password_resets")
}

model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  parentId String?
  active   Boolean    @default(true)

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  listings Listing[]

  @@map("categories")
}

model Listing {
  id                     String        @id @default(cuid())
  sellerId               String
  collegeId              String
  categoryId             String
  title                  String
  description            String
  condition              ItemCondition
  listingType            ListingType
  fixedPrice             Decimal?      @db.Decimal(12, 2)
  minimumAcceptablePrice Decimal?      @db.Decimal(12, 2)
  negotiationEnabled     Boolean       @default(false)
  pickupLocation         String
  status                 ListingStatus @default(DRAFT)
  viewCount              Int           @default(0)
  // Full-text search vector, updated by trigger/explicit update
  searchVector           Unsupported("tsvector")?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  seller     User           @relation("SellerListings", fields: [sellerId], references: [id])
  college    College        @relation(fields: [collegeId], references: [id])
  category   Category       @relation(fields: [categoryId], references: [id])
  images     ListingImage[]
  auction    Auction?
  purchases  Purchase[]
  offers     Offer[]
  conversations Conversation[]
  favourites Favourite[]
  reports    Report[]

  @@index([collegeId])
  @@index([sellerId])
  @@index([categoryId])
  @@index([status])
  @@index([listingType])
  @@index([createdAt(sort: Desc)])
  @@map("listings")
}

model ListingImage {
  id           String  @id @default(cuid())
  listingId    String
  imageUrl     String
  displayOrder Int     @default(0)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("listing_images")
}

model Auction {
  id                String        @id @default(cuid())
  listingId         String        @unique
  startsAt          DateTime
  endsAt            DateTime
  startingBid       Decimal       @db.Decimal(12, 2)
  minimumBidIncrement Decimal     @db.Decimal(12, 2) @default(1)
  reservePrice      Decimal?      @db.Decimal(12, 2)
  currentHighestBid Decimal?      @db.Decimal(12, 2)
  highestBidderId   String?
  status            AuctionStatus @default(SCHEDULED)
  closedAt          DateTime?
  version           Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  listing Listing @relation(fields: [listingId], references: [id])
  bids    Bid[]

  @@index([status])
  @@index([endsAt])
  @@map("auctions")
}

model Bid {
  id        String   @id @default(cuid())
  auctionId String
  bidderId  String
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  auction  Auction   @relation(fields: [auctionId], references: [id])
  bidder   User      @relation(fields: [bidderId], references: [id])
  purchase Purchase? @relation("WinningBidPurchase")

  @@index([auctionId])
  @@index([bidderId])
  @@map("bids")
}

model Purchase {
  id                 String         @id @default(cuid())
  listingId          String
  buyerId            String
  sellerId           String
  acceptedOfferId    String?        @unique
  winningBidId       String?        @unique
  agreedPrice        Decimal        @db.Decimal(12, 2)
  status             PurchaseStatus @default(PENDING)
  reservedUntil      DateTime?
  buyerConfirmedAt   DateTime?
  sellerConfirmedAt  DateTime?
  completedAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  listing      Listing  @relation(fields: [listingId], references: [id])
  buyer        User     @relation("BuyerPurchases", fields: [buyerId], references: [id])
  seller       User     @relation("SellerPurchases", fields: [sellerId], references: [id])
  acceptedOffer Offer?  @relation("AcceptedOfferPurchase", fields: [acceptedOfferId], references: [id])
  winningBid   Bid?     @relation("WinningBidPurchase", fields: [winningBidId], references: [id])
  reviews      Review[]

  @@index([listingId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@map("purchases")
}

model Offer {
  id            String      @id @default(cuid())
  listingId     String
  buyerId       String
  sellerId      String
  amount        Decimal     @db.Decimal(12, 2)
  parentOfferId String?
  status        OfferStatus @default(PENDING)
  expiresAt     DateTime
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  listing      Listing   @relation(fields: [listingId], references: [id])
  buyer        User      @relation("BuyerOffers", fields: [buyerId], references: [id])
  seller       User      @relation("SellerOffers", fields: [sellerId], references: [id])
  parentOffer  Offer?    @relation("OfferCounterOffers", fields: [parentOfferId], references: [id])
  counterOffers Offer[]  @relation("OfferCounterOffers")
  purchase     Purchase? @relation("AcceptedOfferPurchase")

  @@index([listingId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@map("offers")
}

model Conversation {
  id        String   @id @default(cuid())
  listingId String
  buyerId   String
  sellerId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing  Listing   @relation(fields: [listingId], references: [id])
  buyer    User      @relation("BuyerConversations", fields: [buyerId], references: [id])
  seller   User      @relation("SellerConversations", fields: [sellerId], references: [id])
  messages Message[]

  @@unique([listingId, buyerId, sellerId])
  @@index([buyerId])
  @@index([sellerId])
  @@map("conversations")
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime  @default(now())
  readAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}

model Favourite {
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@map("favourites")
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  type        NotificationType
  entityType  String?
  entityId    String?
  message     String
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  recipient User @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@index([readAt])
  @@map("notifications")
}

model Review {
  id          String   @id @default(cuid())
  purchaseId  String
  reviewerId  String
  revieweeId  String
  rating      Int
  comment     String?
  createdAt   DateTime @default(now())

  purchase Purchase @relation(fields: [purchaseId], references: [id])
  reviewer User     @relation("ReviewerReviews", fields: [reviewerId], references: [id])
  reviewee User     @relation("RevieweeReviews", fields: [revieweeId], references: [id])

  @@unique([purchaseId, reviewerId])
  @@index([revieweeId])
  @@map("reviews")
}

model Report {
  id                  String         @id @default(cuid())
  reporterId          String
  reportedUserId      String?
  listingId           String?
  category            ReportCategory
  description         String
  status              ReportStatus   @default(OPEN)
  assignedModeratorId String?
  resolutionNotes     String?
  createdAt           DateTime       @default(now())
  resolvedAt          DateTime?
  updatedAt           DateTime       @updatedAt

  reporter          User     @relation("ReporterReports", fields: [reporterId], references: [id])
  reportedUser      User?    @relation("ReportedUserReports", fields: [reportedUserId], references: [id])
  listing           Listing? @relation(fields: [listingId], references: [id])
  assignedModerator User?    @relation("ModeratorReports", fields: [assignedModeratorId], references: [id])

  @@index([status])
  @@index([assignedModeratorId])
  @@map("reports")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}
